# Copy to .env (gitignored — never commit). Fill in real keys.
# Chain order is fixed in code: cleanapis -> gemini -> opencode.
# Each provider is tried with its PRIMARY model first; when a model reports
# "resource exhausted" or "model unavailable" the server moves to that
# provider's *_MODEL_FALLBACKS list, then to the next provider. It never
# re-hammers the same model.

# --- Primary provider: CleanAPIs (OpenAI-compatible) ---
CLEAN_API_KEY=
CLEAN_BASE_URL=https://cleanapis.com/v1
CLEAN_MODEL=claude-opus-4.8
# Comma-separated models to rotate to when CLEAN_MODEL is busy/unavailable.
CLEAN_MODEL_FALLBACKS=

# --- Failover provider 1: Google Gemini ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=

# --- Failover provider 2: OpenCode (OpenAI-compatible) ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=nemotron-3-ultra-free
OPENCODE_MODEL_FALLBACKS=

# --- CORS: production frontend origin(s), comma-separated ---
# Must include the GitHub Pages origin. Add Render preview URLs as needed.
FRONTEND_ORIGINS=https://sandra-chukwuemeka.github.io

# --- Server ---
PORT=8000
# 0 = one attempt per (provider, model) pair. Only raised if you want the same
# model retried on pure network errors (never on quota/model-unavailable).
MAX_RETRIES_PER_PROVIDER=0
# Seconds to wait for a model's first token before rotating to the next one.
FIRST_TOKEN_TIMEOUT=60
